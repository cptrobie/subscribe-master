# --- Maven ---
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- Java ---
*.class
hs_err_pid*
replay_pid*

# --- IntelliJ IDEA ---
.idea/
*.iml
*.ipr
*.iws
out/

# --- VS Code (in case anyone switches editors) ---
.vscode/

# --- OS-generated files ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Environment / secrets ---
# Nothing here should ever contain a real secret (Vault owns those — see
# ARCHITECTURE.md §9), but these are still excluded defensively in case a
# local override file is ever created with real-looking values for testing.
.env
.env.local
.env.*.local
application-local.yml
application-local.yaml
flyway.local.conf

# --- Vault ---
# Created by `vault login` when using the Vault CLI locally; contains a
# live token and must never be committed.
.vault-token

# --- Spring Boot ---
*.pid

# --- Docker ---
docker-compose.override.yml
